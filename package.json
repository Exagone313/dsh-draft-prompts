{
  "name": "@exagone313/dsh-draft-prompts",
  "version": "1.0.0",
  "description": "Adds a right-sidebar tab for drafting prompts in DeepSeek Harness (dsh).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Exagone313/dsh-draft-prompts.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "bump-version": "node scripts/bump-version.mjs",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/build-client-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-api-remotes": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.2.1-rc.2",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "dprint": "0.63.0",
    "esbuild": "^0.28.2",
    "oxlint": "1.89.0",
    "react": "^18.2.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "dsh": "^0.2.1-rc.2",
    "node": ">=22"
  },
  "packageManager": "pnpm@12.11.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-api-remotes": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.2.1-rc.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar-right": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
